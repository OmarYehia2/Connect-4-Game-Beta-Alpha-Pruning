{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "compile",
            "type": "process",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-g",
                "-mwindows",
                "-static-libgcc",
                "-static-libstdc++",
                "-DSFML_STATIC",
                "${workspaceFolder}\\main.cpp",
                "-ID:\\SFML-3.1.0\\include",
                "-LD:\\SFML-3.1.0\\lib",
                "-o",
                "${workspaceFolder}\\main.exe",
                "-lsfml-graphics-s",
                "-lsfml-window-s",
                "-lsfml-system-s",
                "-lfreetype",
                "-lharfbuzz",
                "-lopengl32",
                "-lgdi32",
                "-lwinmm"
            ],
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "copy runtime dll",
            "type": "process",
            "command": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
            "args": [
                "-NoProfile",
                "-Command",
                "Copy-Item 'C:\\msys64\\ucrt64\\bin\\libwinpthread-1.dll' '${workspaceFolder}\\libwinpthread-1.dll' -Force"
            ]
        },
        {
            "label": "build",
            "dependsOrder": "sequence",
            "dependsOn": [
                "compile",
                "copy runtime dll"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "silent"
            }
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-mwindows",
                "-static-libgcc",
                "-static-libstdc++",
                "-DSFML_STATIC",
                "${file}",
                "-ID:\\SFML-3.1.0\\include",
                "-LD:\\SFML-3.1.0\\lib",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe",
                "-lsfml-graphics-s",
                "-lsfml-window-s",
                "-lsfml-system-s",
                "-lfreetype",
                "-lharfbuzz",
                "-lopengl32",
                "-lgdi32",
                "-lwinmm"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Task generated by Debugger."
        }
    ]
}
